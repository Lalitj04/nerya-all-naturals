# Local development profile.
# Copy this file to application-local.yml (already gitignored) and adjust as
# needed, then run with SPRING_PROFILES_ACTIVE=local. Values below are safe
# local-only defaults; nothing here should contain real secrets.

spring:
  datasource:
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:nerya_local}?createDatabaseIfNotExist=true
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:}

springdoc:
  api-docs:
    enabled: true
  swagger-ui:
    enabled: true

logging:
  level:
    com.nerya.neryaallnaturals: DEBUG
